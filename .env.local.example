# StockPilot Agent™ — Environment Configuration
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.

# MongoDB connection string (local or remote)
MONGODB_URI=mongodb://localhost:27017/stockpilot

# Muse Spark API key (Meta Model API — OpenAI-compatible)
# Get from: https://dev.meta.ai → API keys → Create
MUSE_API_KEY=your_muse-spark-1.3_api_key_here

# Enable offline mock agent fallback (true/false)
USE_MOCK_AGENT=false

# Next.js server port
PORT=3000